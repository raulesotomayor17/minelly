{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minelly",
  "version": "0.2.0",
  "identifier": "com.teoamoxtli.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minelly \u00b7 Estudio B\u00edblico",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "x": 10,
        "y": 10,
        "center": false,
        "maximized": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Minelly",
    "copyright": "Copyright \u00a9 2026 Ra\u00fal Sotomayor",
    "category": "Education",
    "shortDescription": "Estudio b\u00edblico local y multiplataforma",
    "longDescription": "Minelly es una aplicaci\u00f3n de escritorio local-first para leer la Biblia, comparar versiones, tomar notas y preparar sermones. No incluye textos b\u00edblicos: importa tus propios m\u00f3dulos.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "espeak-ng"
        ]
      }
    }
  }
}
